# =============================================================================
# Learn-Workbench 宿主告警环境变量（S4-5）
# 安装：cp deploy/host/alert.env.example /etc/lwb/alert.env && chmod 600 /etc/lwb/alert.env
# 说明：alert-check.sh 会优先 source /etc/lwb/alert.env（其次仓库内 deploy/host/alert.env）
# =============================================================================

# 内部接口鉴权（必需；与 web 容器/PM2 进程的 CRON_SECRET 一致）
CRON_SECRET=replace-with-same-cron-secret

# 指标端点（默认本机 3001；docker 部署映射 APP_PORT->3001）
ALERT_METRICS_URL=http://127.0.0.1:3001/api/internal/metrics

# 告警投递（可选）：设置后用 POST JSON 投递，不再依赖 cron MAILTO
# ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# 阈值（全部可选，括号内为默认值）
# ALERT_DISK_MIN_GIB=10
# ALERT_PG_POOL_MAX_RATIO=0.8
# ALERT_5XX_MAX_RATIO=0.05
# ALERT_5XX_MIN_REQUESTS=50
# ALERT_CRON_GRACE_HOUR=6

# 数据库直连检查（默认 auto：连不上就 SKIP 并说明）
#   docker 部署的 db 未暴露端口 -> 保持 auto/off；PM2/本机部署可设 on 让连不上时告警
# ALERT_DB_CHECK=auto
# PG 连接信息（PM2/本机部署时按需覆盖；docker 部署无需）
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=Learn-Workbench
# PGUSER=lwb
# PGPASSWORD=replace-me

# 离线演练：直接读一份 Prometheus 文本文件（不发 HTTP、不连库）
# ALERT_METRICS_FILE=/tmp/lwb-metrics.prom
