# 数据库（本地集群）
.pgdata/

# 本地工具链（conda 安装的 PostgreSQL）
.tools/

# 构建用的 Gradle 用户目录（v1.45）。
# 为什么要放在仓库根、而不是 .local/ 下：Java/Gradle 子进程只能写工作区内的路径，
# 但 Windows 的 260 字符路径上限又卡住了 CMake/ninja（react-native 的 prefab 头文件路径很长）——
# 放在 .local/gradle-home 时实测 269 字符超限，报
# "Filename longer than 260 characters"。.g 比它短 17 字符，刚好留出余量。
.g/

# Python
__pycache__/
*.pyc

# Node
node_modules

# 用户上传的图片（运行期产物，生产挂 COS 桶）
apps/web/public/uploads//
.turbo/
.next/
.expo/
dist/
dist-export/

# pnpm 本地 store（构建产物，勿提交）
.pnpm-store/

# 生成数据 / 下载的背景图
.data/
assets/backgrounds/bing/*.jpg

# 本地日志
*.log

# 测试覆盖率
coverage/

# OS
Thumbs.db
.DS_Store

.backup/

.local/
.workbuddy/

# 环境变量（含服务器部署自动生成的密钥，勿提交）
.env
.env.local
.env.*.local

# 部署产物（deploy.sh 生成）
deploy-credentials.txt
server.pid
prototype/shots/
prototype/tmp/

# 登录态 Cookie（含敏感会话，禁止提交）
config/job-hosts/storageState.json
scripts/.audit_cookie.txt

# 文档仅本地保留，不提交或推送；只允许 README 进入 Git。
# 架构设计、ADR、改动记录、阶段报告、运行手册等继续保存在工作区，但默认不会被 git add。
*.md
!README.md
!**/README.md
*.mdx
!README.mdx
!**/README.mdx

