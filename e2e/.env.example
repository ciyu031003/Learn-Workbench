# 复制为 e2e/.env 后按需修改（.env 已 gitignore）
# 目标站点：本地 dev 默认 http://localhost:3001，服务器实测填 http://106.55.2.197
E2E_BASE_URL=http://localhost:3001
# 登录凭据（不配置则跳过所有登录相关测试）
E2E_USERNAME=admin
E2E_PASSWORD=change-me
# 可选：指定 Chrome 可执行文件（默认使用系统 Chrome channel）
# E2E_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
